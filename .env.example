# ---------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------

# --- Supabase (the same project as the storefront) ---
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role. SERVER ONLY.
# The dashboard writes products and reads every order, so it needs this rather
# than the anon key. It must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public storage buckets. Create both in Supabase -> Storage, Public turned on.
SUPABASE_IMAGE_BUCKET=product-images
SUPABASE_POSTER_BUCKET=posters

# --- Dashboard login (the single admin account) ---
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=generate-a-64-character-hex-string
